import {
  paginate_cursor,
  rate_limit_token_bucket,
  verify_hmac_signature,
} from "std/connectors/shared"

const PROVIDER_ID = "bitbucket"

const STATE_KEY = "harn-bitbucket-connector.state"

const DEFAULT_API_BASE_URL = "https://api.bitbucket.org/2.0"

const ENV_PREFIX = "BITBUCKET"

const SIGNATURE_HEADER = "x-hub-signature"

const EVENT_HEADER = "x-event-key"

const RATE_LIMIT_REMAINING_HEADER = "x-ratelimit-remaining"

const RATE_LIMIT_RESET_HEADER = "x-ratelimit-reset"

const RETRY_AFTER_HEADER = "retry-after"

const DEFAULT_RATE_LIMIT_MAX_WAIT_SECONDS = 60

const MAX_BODY_BYTES = 1048576

const SUPPORTED_EVENTS = [
  "repo:push",
  "pullrequest:created",
  "pullrequest:updated",
  "pullrequest:fulfilled",
  "pullrequest:rejected",
  "pullrequest:comment_created",
  "pullrequest:comment_updated",
  "issue:created",
  "issue:updated",
  "issue:comment_created",
  "repo:commit_status_created",
  "repo:commit_status_updated",
]

const DELIVERY_HEADERS = ["x-hook-uuid", "x-request-uuid"]

const OUTBOUND_METHODS = [
  "api.request",
  "pagination.list",
  "pull_requests.comment",
  "pull_requests.update",
  "issues.comment",
  "commit_status.set",
  "repository_file.get",
]

/** Return this connector's provider id. */
pub fn provider_id() {
  return PROVIDER_ID
}

/** Return supported trigger kinds. */
pub fn kinds() {
  return ["webhook"]
}

/** Return the normalized payload schema metadata. */
pub fn payload_schema() {
  return {
    harn_schema_name: "BitbucketEventPayload",
    json_schema: {
      type: "object",
      required: ["event", "repository", "actor", "raw"],
      additionalProperties: true,
      properties: {
        event: {type: "string"},
        action: {type: ["string", "null"]},
        repository: {type: ["object", "null"], additionalProperties: true},
        actor: {type: ["object", "null"], additionalProperties: true},
        resource: {type: ["object", "null"], additionalProperties: true},
        raw: {type: "object"},
      },
    },
  }
}

/** Initialize connector state with orchestrator context. */
pub fn init(ctx = nil) {
  const next = __state() + {initialized: true, ctx: ctx ?? {}}
  __set_state(next)
  return next
}

/** Activate configured trigger bindings. */
pub fn activate(bindings = []) {
  let by_id = {}
  let seen_paths = {}
  for binding in bindings ?? [] {
    const binding_id = binding?.binding_id ?? binding?.id ?? ("binding-" + to_string(len(by_id.keys())))
    const path = binding?.path ?? binding?.match?.path
    if path != nil && path != "" {
      if seen_paths.get(path) {
        return __err(
          "activation",
          PROVIDER_ID + " connector path `" + path + "` is configured by multiple bindings",
        )
      }
      seen_paths[path] = true
    }
    by_id[binding_id] = binding + {binding_id: binding_id}
  }
  const next = __state() + {bindings: by_id, active: true}
  __set_state(next)
  return {provider: PROVIDER_ID, bindings: len(by_id.keys())}
}

/** Clear connector lifecycle state. */
pub fn shutdown() {
  store_delete(STATE_KEY)
  return {provider: PROVIDER_ID, active: false}
}

@complexity(allow)
/** Verify and normalize an inbound webhook request. */
pub fn normalize_inbound(raw) {
  const body_text = raw?.body_text ?? raw?.body ?? ""
  if len(body_text) > MAX_BODY_BYTES {
    return __reject(413, "payload_too_large", PROVIDER_ID + " webhook body exceeds 1 MiB cap")
  }
  const headers = raw?.headers ?? {}
  const verified = __verify_signature(raw, headers, body_text)
  if is_err(verified) {
    return __reject_err(unwrap_err(verified))
  }
  const signature_status = unwrap(verified)
  const parsed = try {
    json_parse(body_text)
  }
  if is_err(parsed) {
    return __reject(400, "invalid_json", PROVIDER_ID + " payload body is not valid JSON")
  }
  const payload = unwrap(parsed)
  const base_event = __base_event(payload, headers)
  if base_event == nil || base_event == "" {
    return __reject(400, "missing_event", "missing " + PROVIDER_ID + " event header or payload event")
  }
  if !__supports_event(base_event) {
    return __reject(
      400,
      "unsupported_event",
      "unsupported " + PROVIDER_ID + " event `" + to_string(base_event) + "`",
    )
  }
  const event = __build_event(base_event, payload, raw, headers, signature_status, body_text)
  return {type: "event", event: event}
}

/** Polling stub; Bitbucket bindings are webhook-only today. */
pub fn poll_tick(ctx = nil) {
  return {type: "batch", events: [], cursor: ctx?.cursor, state: ctx?.state ?? {}}
}

@complexity(allow)
/** Dispatch a supported outbound helper method. */
pub fn call(method, args = {}) {
  if !contains(OUTBOUND_METHODS, method) {
    return __err(
      "method_not_found",
      PROVIDER_ID + " connector does not implement outbound method `" + method + "`",
    )
  }
  if method == "api.request" {
    return __api_request(args ?? {})
  }
  if method == "pagination.list" {
    return __pagination_list(args ?? {})
  }
  if method == "pull_requests.comment" {
    return __api_request(
      args
        + {
        method: "POST",
        path: args?.path ?? __pull_request_comment_path(args),
        body: {body: args?.body ?? args?.comment},
      },
    )
  }
  if method == "pull_requests.update" {
    return __api_request(
      args
        + {
        method: "PATCH",
        path: args?.path ?? __pull_request_path(args),
        body: __body_without(args, __config_keys() + ["owner", "repo", "pull_request", "pull_request_id", "path"]),
      },
    )
  }
  if method == "issues.comment" {
    return __api_request(
      args
        + {
        method: "POST",
        path: args?.path ?? __issue_comment_path(args),
        body: {body: args?.body ?? args?.comment},
      },
    )
  }
  if method == "commit_status.set" {
    return __api_request(
      args
        + {
        method: "POST",
        path: args?.path ?? __commit_status_path(args),
        body: __body_without(args, __config_keys() + ["owner", "repo", "sha", "path"]),
      },
    )
  }
  return __api_request(args + {method: "GET", path: args?.path ?? __repository_file_path(args)})
}

fn __state() {
  return store_get(STATE_KEY) ?? {initialized: false, active: false, bindings: {}, ctx: {}}
}

fn __set_state(state) {
  store_set(STATE_KEY, state)
  return state
}

fn __err(code, message) {
  return Err({code: code, message: message})
}

fn __reject(status, code, message) {
  return {
    type: "reject",
    reject: {
      status: status,
      body: json_stringify({error: code, message: message}),
      content_type: "application/json",
    },
  }
}

fn __reject_err(err) {
  const code = err?.code ?? "rejected"
  const status = if code == "invalid_signature" || code == "missing_signature" || code == "missing_secret" {
    401
  } else {
    400
  }
  return __reject(status, code, err?.message ?? "request rejected")
}

fn __header(headers, name) {
  const wanted = lowercase(name)
  for entry in (headers ?? {}).entries() {
    if lowercase(trim(to_string(entry.key))) == wanted {
      return trim(to_string(entry.value))
    }
  }
  return nil
}

fn __base_event(payload, headers) {
  const from_header = __header(headers, EVENT_HEADER)
  if from_header != nil && from_header != "" {
    return to_string(from_header)
  }
  return payload?.event ?? payload?.event_name ?? payload?.object_kind ?? payload?.type ?? payload?.action
}

fn __supports_event(event) {
  if contains(SUPPORTED_EVENTS, event) {
    return true
  }
  const normalized = __normalize_kind(event)
  for supported in SUPPORTED_EVENTS {
    if starts_with(normalized, __normalize_kind(supported)) {
      return true
    }
  }
  return false
}

fn __verify_signature(raw, headers, body_text) {
  const secret = __signing_secret(raw)
  if secret == nil || trim(to_string(secret)) == "" {
    if __binding_allows_unsigned(raw) {
      return Ok("unsigned")
    }
    return __err(
      "missing_secret",
      PROVIDER_ID
        + " signing_secret is required; set `allow_unsigned: true` on the binding to accept unsigned webhooks",
    )
  }
  const provided = __header(headers, SIGNATURE_HEADER)
  if provided == nil || provided == "" {
    return __err("missing_signature", SIGNATURE_HEADER + " header missing but a signing_secret is configured")
  }
  if verify_hmac_signature(body_text, to_string(provided), to_string(secret)) {
    return Ok("signed")
  }
  return __err("invalid_signature", SIGNATURE_HEADER + " did not match the configured signing_secret")
}

fn __signing_secret(raw) {
  const state = __state()
  const ctx_secret = state?.ctx?.signing_secret ?? state?.ctx?.secrets?.signing_secret
  if ctx_secret != nil && trim(to_string(ctx_secret)) != "" {
    return to_string(ctx_secret)
  }
  const bindings = state?.bindings ?? {}
  const binding_id = raw?.metadata?.binding_id ?? raw?.binding_id
  if binding_id != nil {
    const binding = bindings.get(binding_id)
    const binding_secret = binding?.signing_secret ?? binding?.secrets?.signing_secret
      ?? binding?.config?.signing_secret
    if binding_secret != nil && trim(to_string(binding_secret)) != "" {
      return to_string(binding_secret)
    }
  }
  const secret_id = __signing_secret_id(raw)
  if secret_id != nil {
    const resolved = try {
      secret_get(secret_id)
    }
    if !is_err(resolved) {
      const value = to_string(unwrap(resolved))
      if value != "" {
        return value
      }
    }
  }
  return nil
}

fn __signing_secret_id(raw) {
  const metadata = raw?.metadata ?? {}
  const id = metadata?.secret_ids?.signing_secret ?? metadata?.config?.secret_ids?.signing_secret
  if id != nil && trim(to_string(id)) != "" {
    return to_string(id)
  }
  const bindings = __state()?.bindings ?? {}
  const binding_id = metadata?.binding_id ?? raw?.binding_id
  if binding_id != nil {
    const binding = bindings.get(binding_id)
    const bid = binding?.signing_secret_id ?? binding?.secrets?.signing_secret_id
      ?? binding?.config?.secret_ids?.signing_secret
    if bid != nil && trim(to_string(bid)) != "" {
      return to_string(bid)
    }
  }
  return nil
}

fn __binding_allows_unsigned(raw) {
  const bindings = __state()?.bindings ?? {}
  const binding_id = raw?.metadata?.binding_id ?? raw?.binding_id
  if binding_id == nil {
    return false
  }
  const binding = bindings.get(binding_id)
  if binding == nil {
    return false
  }
  return binding?.allow_unsigned ?? binding?.config?.allow_unsigned ?? false
}

@complexity(allow)
fn __build_event(base_event, payload, raw, headers, signature_status, body_text) {
  const kind = __event_kind(base_event, payload)
  return {
    kind: kind,
    occurred_at: raw?.occurred_at ?? payload?.updated_at ?? payload?.created_at ?? payload?.timestamp,
    dedupe_key: __dedupe_key(base_event, payload, raw, headers, body_text),
    signature_status: __signature_status(signature_status),
    payload: {
      event: base_event,
      action: payload?.action,
      repository: __repository(payload),
      actor: __actor(payload),
      resource: __resource(payload),
      merge: __pr_merge_state(base_event, payload),
      mention: __mention_block(base_event, payload),
      raw: payload,
    },
    headers: __normalized_headers(headers),
  }
}

fn __signature_status(status) {
  if status == "signed" || status == "verified" {
    return {state: "verified"}
  }
  return {state: "unsigned"}
}

fn __event_kind(base_event, payload) {
  const normalized = __normalize_kind(base_event)
  const action = payload?.action ?? payload?.pullrequest?.state ?? payload?.object_attributes?.action
  if action == nil || action == "" || contains(normalized, ".") {
    return normalized
  }
  return normalized + "." + __normalize_kind(action)
}

fn __normalize_kind(value) {
  return lowercase(replace(replace(to_string(value), ":", "."), " ", "_"))
}

fn __repository(payload) {
  const repo = payload?.repository ?? payload?.repo ?? {}
  return {
    id: repo?.id ?? repo?.uuid,
    name: repo?.name,
    full_name: repo?.full_name ?? repo?.path_with_namespace ?? repo?.canonical_name,
    url: repo?.html_url ?? repo?.web_url ?? repo?.links?.html?.href ?? repo?.url,
  }
}

fn __actor(payload) {
  const actor = payload?.sender ?? payload?.user ?? payload?.actor ?? payload?.pusher ?? {}
  return {
    id: actor?.id ?? actor?.uuid,
    username: actor?.login ?? actor?.username ?? actor?.nickname ?? actor?.canonical_name,
    name: actor?.name ?? actor?.display_name,
    email: actor?.email,
  }
}

fn __resource(payload) {
  return payload?.pull_request ?? payload?.pullrequest ?? payload?.issue ?? payload?.comment
    ?? payload?.release
    ?? payload?.object_attributes
    ?? {revision: payload?.revision, changed_paths: payload?.changed_paths, commits: payload?.commits}
}

/**
 * Surface PR merge/conflict state for `pullrequest:*` events, or nil for
 * non-PR events. Bitbucket webhooks do not always carry an explicit conflict
 * flag (that needs a follow-up `GET .../diffstat` / `/merge` call), so
 * `is_conflict` is only set when the payload exposes a hint; `merge_state`
 * always reflects the PR `state` plus any `merge_commit` present.
 */
fn __pr_merge_state(base_event, payload) {
  const normalized = __normalize_kind(base_event)
  if !starts_with(normalized, "pullrequest") {
    return nil
  }
  const pr = payload?.pullrequest ?? payload?.pull_request ?? {}
  const state = pr?.state
  const merge_commit = pr?.merge_commit?.hash ?? pr?.merge_commit
  const merge_state = if state != nil && to_string(state) != "" {
    lowercase(to_string(state))
  } else {
    "unknown"
  }
  let result = {merge_commit: merge_commit, merge_state: merge_state}
  const conflict_hint = __pr_conflict_hint(pr)
  if conflict_hint != nil {
    result["is_conflict"] = conflict_hint
  }
  return result
}

/**
 * Extract an explicit conflict signal from a Bitbucket PR object when one is
 * present. Returns nil when the webhook carries no mergeability hint (the
 * common case) so callers can fall back to an API probe. Handles the
 * Data Center `properties.mergeResult.outcome == "CONFLICTED"` shape and any
 * boolean `has_conflicts` / `conflicted` flag.
 */
fn __pr_conflict_hint(pr) {
  const has_conflicts = pr?.has_conflicts ?? pr?.conflicted
  if has_conflicts != nil {
    return has_conflicts == true
  }
  const outcome = pr?.properties?.mergeResult?.outcome ?? pr?.merge_result?.outcome
  if outcome != nil && to_string(outcome) != "" {
    return uppercase(to_string(outcome)) == "CONFLICTED"
  }
  return nil
}

/**
 * Build an `@`-mention command block for PR-comment and issue-comment events.
 * Scans the comment body for `@handle command args...` lines and returns a
 * `{actor, candidates: [{handle, command, rest}], target_kind, target_id,
 * url}` block, or nil when the event is not a comment or no mention is found.
 * CPU-only string parsing, no network.
 */
fn __mention_block(base_event, payload) {
  const normalized = __normalize_kind(base_event)
  const is_pr_comment = starts_with(normalized, "pullrequest") && payload?.comment != nil
  const is_issue_comment = starts_with(normalized, "issue") && payload?.comment != nil
  if !is_pr_comment && !is_issue_comment {
    return nil
  }
  const comment = payload?.comment ?? {}
  const body = to_string(comment?.content?.raw ?? comment?.content ?? comment?.body ?? "")
  const candidates = __extract_mentions(body)
  if len(candidates) == 0 {
    return nil
  }
  const target = if is_pr_comment {
    payload?.pullrequest ?? payload?.pull_request ?? {}
  } else {
    payload?.issue ?? {}
  }
  const target_kind = if is_pr_comment {
    "pull_request"
  } else {
    "issue"
  }
  return {
    actor: __actor(payload),
    candidates: candidates,
    target_id: target?.id,
    target_kind: target_kind,
    url: comment?.links?.html?.href ?? target?.links?.html?.href,
  }
}

/**
 * Extract `@handle command args...` mentions from free text. Each line is
 * scanned token-by-token; the first `@handle` followed by a command word
 * yields one candidate `{command, handle, rest}`. Pure string parsing.
 */
fn __extract_mentions(body) {
  let candidates = []
  for line in split(to_string(body), "\n") {
    const tokens = __whitespace_tokens(line)
    if len(tokens) < 2 {
      continue
    }
    const first = tokens[0]
    if !starts_with(first, "@") || len(first) < 2 {
      continue
    }
    const handle = first[1:len(first)]
    if handle == "" {
      continue
    }
    const command = tokens[1]
    const rest = if len(tokens) > 2 {
      join(tokens[2:len(tokens)], " ")
    } else {
      ""
    }
    candidates = candidates + [{command: command, handle: handle, rest: rest}]
  }
  return candidates
}

/** Split text on ASCII whitespace runs, dropping empty tokens. */
fn __whitespace_tokens(text) {
  let tokens = []
  let current = ""
  for ch in split(to_string(text), "") {
    if ch == " " || ch == "\t" || ch == "\r" {
      if current != "" {
        tokens = tokens + [current]
        current = ""
      }
    } else {
      current = current + ch
    }
  }
  if current != "" {
    tokens = tokens + [current]
  }
  return tokens
}

fn __dedupe_key(base_event, payload, raw, headers, body_text) {
  for header in DELIVERY_HEADERS {
    const value = __header(headers, header)
    if value != nil && value != "" {
      return PROVIDER_ID + ":" + __normalize_kind(base_event) + ":" + to_string(value)
    }
  }
  const payload_id = payload?.id ?? payload?.uuid ?? payload?.delivery_id ?? payload?.revision
  if payload_id != nil {
    return PROVIDER_ID + ":" + __normalize_kind(base_event) + ":" + to_string(payload_id)
  }
  return PROVIDER_ID + ":" + __normalize_kind(base_event) + ":" + sha256(body_text)
}

fn __normalized_headers(headers) {
  let normalized = {}
  const event = __header(headers, EVENT_HEADER)
  if event != nil {
    normalized[EVENT_HEADER] = event
  }
  const signature = __header(headers, SIGNATURE_HEADER)
  if signature != nil {
    normalized[SIGNATURE_HEADER] = signature
  }
  for header in DELIVERY_HEADERS {
    const value = __header(headers, header)
    if value != nil {
      normalized[header] = value
    }
  }
  return normalized
}

@complexity(allow)
fn __outbound_config(args) {
  const env_base = ENV_PREFIX + "_API_BASE_URL"
  const env_token = ENV_PREFIX + "_TOKEN"
  const api_base_url = args?.api_base_url ?? harness.env.get_or(env_base, DEFAULT_API_BASE_URL)
  const base_check = __validate_api_base_url(api_base_url)
  if is_err(base_check) {
    return base_check
  }
  const access_token = args?.access_token ?? args?.token ?? args?.personal_access_token ?? args?.app_password
    ?? args?.secrets?.access_token
    ?? harness.env.get(env_token)
  return Ok({api_base_url: to_string(api_base_url), access_token: access_token})
}

fn __config_keys() {
  return [
    "api_base_url",
    "access_token",
    "token",
    "personal_access_token",
    "app_password",
    "secrets",
    "rate_limit_max_wait_seconds",
    "now",
  ]
}

fn __body_without(args, keys) {
  const body = (args ?? {}) + {}
  for key in keys {
    body.remove(key)
  }
  return body
}

@complexity(allow)
fn __api_request(args) {
  const config = __outbound_config(args ?? {})
  if is_err(config) {
    return config
  }
  const cfg = unwrap(config)
  const method = uppercase(to_string(args?.method ?? "GET"))
  const path = args?.path ?? args?.url_path ?? ""
  let options = {headers: {Accept: "application/json"}, retry: {max: 0, backoff_ms: 0}}
  if cfg.access_token != nil && trim(to_string(cfg.access_token)) != "" {
    options.headers["Authorization"] = "Bearer " + to_string(cfg.access_token)
  }
  if args?.body != nil {
    options["body"] = json_stringify(args.body)
    options.headers["Content-Type"] = "application/json"
  }
  const url_result = __api_url(cfg.api_base_url, path)
  if is_err(url_result) {
    return url_result
  }
  const url = unwrap(url_result)
  return __send_with_rate_limit_retry(method, url, options, args)
}

@complexity(allow)
fn __send_with_rate_limit_retry(method, url, options, args) {
  const max_wait_seconds = args?.rate_limit_max_wait_seconds ?? DEFAULT_RATE_LIMIT_MAX_WAIT_SECONDS
  const override_now = args?.now
  let retried_rate_limit = false
  while true {
    const response_result = try {
      harness.net.request(method, url, options)
    }
    if is_err(response_result) {
      return __err("transport", to_string(unwrap_err(response_result)))
    }
    const response = unwrap(response_result)
    if response.status >= 200 && response.status < 300 {
      return __decode_body(response)
    }
    if !retried_rate_limit && __is_throttled_status(response.status) {
      const wait = __rate_limit_wait(response, max_wait_seconds, override_now)
      if is_err(wait) {
        return wait
      }
      retried_rate_limit = true
      continue
    }
    const code = if __is_throttled_status(response.status) {
      "rate_limited"
    } else if response.status == 401 || response.status == 403 {
      "unauthorized"
    } else {
      "transport"
    }
    return __err(
      code,
      PROVIDER_ID + " API request failed with status " + to_string(response.status) + ": "
        + (response.body ?? ""),
    )
  }
}

fn __decode_body(response) {
  if trim(response.body ?? "") == "" {
    return {status: response.status, headers: response.headers, body: ""}
  }
  const parsed = try {
    json_parse(response.body)
  }
  if is_err(parsed) {
    return __err("invalid_response", PROVIDER_ID + " API returned invalid JSON")
  }
  return unwrap(parsed)
}

fn __is_throttled_status(status) {
  return status == 429 || status == 503
}

fn __rate_limit_wait(response, max_wait_seconds, override_now) {
  const wait_seconds = __rate_limit_wait_seconds(response.status, response.headers ?? {}, override_now)
    ?? 0
  if wait_seconds > max_wait_seconds {
    return __err(
      "rate_limited",
      PROVIDER_ID + " API rate limit reset is more than " + to_string(max_wait_seconds)
        + " seconds away",
    )
  }
  if wait_seconds > 0 {
    sleep(wait_seconds * 1000)
  }
  return Ok(true)
}

fn __rate_limit_wait_seconds(status, headers, override_now) {
  const retry_after = __retry_after_seconds(headers)
  if retry_after != nil {
    return retry_after
  }
  const remaining = __header(headers, RATE_LIMIT_REMAINING_HEADER)
  const exhausted = remaining != nil && trim(to_string(remaining)) == "0"
  if !exhausted && status != 429 {
    return nil
  }
  const reset = __header(headers, RATE_LIMIT_RESET_HEADER)
  if reset == nil || trim(to_string(reset)) == "" {
    if status == 429 || exhausted {
      return 0
    }
    return nil
  }
  const parsed_reset = try {
    to_int(reset)
  }
  if is_err(parsed_reset) {
    return 0
  }
  const now = override_now ?? to_int(harness.clock.timestamp())
  const wait = unwrap(parsed_reset) - now
  if wait < 0 {
    return 0
  }
  return wait
}

fn __retry_after_seconds(headers) {
  const value = __header(headers, RETRY_AFTER_HEADER)
  if value == nil || trim(to_string(value)) == "" {
    return nil
  }
  const parsed = try {
    to_int(value)
  }
  if is_err(parsed) {
    return nil
  }
  const seconds = unwrap(parsed)
  if seconds < 0 {
    return 0
  }
  return seconds
}

@complexity(allow)
fn __pagination_list(args) {
  const config = __outbound_config(args ?? {})
  if is_err(config) {
    return config
  }
  const cfg = unwrap(config)
  const initial_path = args?.path ?? args?.url_path ?? args?.url ?? ""
  if trim(to_string(initial_path)) == "" {
    return __err("invalid_args", "pagination.list requires `path` or `url`")
  }
  const initial_url_result = __api_url(cfg.api_base_url, initial_path)
  if is_err(initial_url_result) {
    return initial_url_result
  }
  const initial_url = unwrap(initial_url_result)
  const max_pages = args?.max_pages ?? 100
  const items_path = args?.items_path ?? "/values"
  const cursor_path = args?.cursor_path ?? "/next"
  const request_args = args + {}
  request_args.remove("path")
  request_args.remove("url")
  request_args.remove("url_path")
  request_args.remove("max_pages")
  request_args.remove("items_path")
  request_args.remove("cursor_path")
  const fetch = { _initial, cursor ->
    let target = if cursor == nil || trim(to_string(cursor)) == "" {
      initial_url
    } else {
      to_string(cursor)
    }
    let result = __api_request(request_args + {method: "GET", path: target})
    if is_err(result) {
      throw unwrap_err(result)
    }
    return result
  }
  const outcome = try {
    paginate_cursor(initial_url, fetch, cursor_path, {items_path: items_path, max_pages: max_pages})
  }
  if is_err(outcome) {
    return Err(unwrap_err(outcome))
  }
  return unwrap(outcome)
}

fn __api_url(api_base_url, path) {
  const base = trim(to_string(api_base_url))
  const prefix = if ends_with(base, "/") {
    base[0:len(base) - 1]
  } else {
    base
  }
  const path_str = to_string(path)
  const path_lc = lowercase(path_str)
  // F2: refuse arbitrary absolute URLs. Pagination cursors that point back to
  // the same host as api_base_url are still allowed (Bitbucket's REST API
  // returns absolute `next` cursors).
  if starts_with(path_lc, "http://") || starts_with(path_lc, "https://") {
    if !starts_with(path_lc, lowercase(prefix) + "/") && lowercase(path_str) != lowercase(prefix) {
      return __err(
        "invalid_path",
        "bitbucket api.request rejects absolute URL paths that escape the configured api_base_url host; pass a path beginning with /",
      )
    }
    return Ok(path_str)
  }
  if starts_with(path_str, "/") {
    return Ok(prefix + path_str)
  }
  return Ok(prefix + "/" + path_str)
}

@complexity(allow)
fn __validate_api_base_url(api_base_url) {
  if api_base_url == nil || trim(to_string(api_base_url)) == "" {
    return __err("invalid_api_base_url", "api_base_url is required")
  }
  const url = trim(to_string(api_base_url))
  if !starts_with(lowercase(url), "https://") {
    return __err("invalid_api_base_url", "api_base_url must use https:// scheme")
  }
  const after_scheme = url[8:len(url)]
  const slash_idx = __index_of(after_scheme, "/")
  const host_port = if slash_idx >= 0 {
    after_scheme[0:slash_idx]
  } else {
    after_scheme
  }
  const host = __strip_port(host_port)
  if host == "" {
    return __err("invalid_api_base_url", "api_base_url is missing a host")
  }
  const host_lc = lowercase(host)
  if __is_disallowed_host(host_lc) {
    return __err(
      "invalid_api_base_url",
      "api_base_url host `" + host
        + "` is not allowed (loopback/private/link-local/.internal/.local are blocked)",
    )
  }
  return Ok(true)
}

fn __strip_port(host_port) {
  if starts_with(host_port, "[") {
    const close = __index_of(host_port, "]")
    if close >= 0 {
      return host_port[1:close]
    }
    return host_port
  }
  const colon = __index_of(host_port, ":")
  if colon >= 0 {
    return host_port[0:colon]
  }
  return host_port
}

fn __index_of(text, needle) {
  const n = len(text)
  const m = len(needle)
  if m == 0 {
    return 0
  }
  let i = 0
  while i + m <= n {
    if text[i:i + m] == needle {
      return i
    }
    i = i + 1
  }
  return -1
}

@complexity(allow)
fn __is_disallowed_host(host_lc) {
  if host_lc == "localhost" {
    return true
  }
  if ends_with(host_lc, ".localhost") || ends_with(host_lc, ".local")
    || ends_with(host_lc, ".internal") {
    return true
  }
  if host_lc == "::1" || host_lc == "0:0:0:0:0:0:0:1" {
    return true
  }
  if starts_with(host_lc, "127.") || starts_with(host_lc, "10.")
    || starts_with(host_lc, "169.254.")
    || starts_with(host_lc, "192.168.") {
    return true
  }
  if starts_with(host_lc, "172.") {
    const rest = host_lc[4:len(host_lc)]
    const dot = __index_of(rest, ".")
    if dot > 0 {
      const octet_str = rest[0:dot]
      const parsed = try {
        to_int(octet_str)
      }
      if !is_err(parsed) {
        const octet = unwrap(parsed)
        if octet >= 16 && octet <= 31 {
          return true
        }
      }
    }
  }
  return false
}

fn __repo_ref(args) {
  const owner = args?.owner ?? args?.workspace ?? args?.project ?? ""
  const repo = args?.repo ?? args?.repository ?? ""
  if owner != "" && repo != "" {
    return url_encode(to_string(owner)) + "/" + url_encode(to_string(repo))
  }
  return url_encode(to_string(args?.repo_full_name ?? args?.repository_full_name ?? ""))
}

fn __pull_request_path(args) {
  return "/repos/" + __repo_ref(args) + "/pulls/" + to_string(args?.pull_request ?? args?.pull_request_id)
}

fn __pull_request_comment_path(args) {
  return __pull_request_path(args) + "/comments"
}

fn __issue_comment_path(args) {
  return "/repos/" + __repo_ref(args) + "/issues/" + to_string(args?.issue ?? args?.issue_id) + "/comments"
}

fn __commit_status_path(args) {
  return "/repos/" + __repo_ref(args) + "/statuses/" + to_string(args?.sha ?? args?.commit)
}

fn __repository_file_path(args) {
  return "/repos/" + __repo_ref(args) + "/contents/" + url_encode(to_string(args?.path ?? ""))
}

/** Token-bucket gate that bindings can use to throttle outbound traffic. */
pub fn rate_limit_gate(state = nil, config = nil, now_ms = nil) {
  return rate_limit_token_bucket(state, config, now_ms)
}
