import { call, rate_limit_gate } from "../src/lib"

@complexity(allow)
pipeline default(harness: Harness) {
  harness.net.egress_policy({allow: ["bitbucket-api.test"], default: "deny"})
  harness.testing.http_mock_clear()
  const base = "https://bitbucket-api.test/2.0"
  const path = "/repositories/acme/widgets/pullrequests"
  const url = base + path
  harness.testing.http_mock(
    "GET",
    url,
    {
      responses: [
        {
          status: 429,
          body: "{\"error\":\"throttled\"}",
          headers: {"x-ratelimit-remaining": "0", "x-ratelimit-reset": "0", "retry-after": "0"},
        },
        {status: 200, body: "{\"values\":[{\"id\":1}]}"},
      ],
    },
  )
  const retried = call(
    harness,
    "api.request",
    {api_base_url: base, path: path, access_token: "token", rate_limit_max_wait_seconds: 0, now: 0},
  )
  assert_eq(retried.values[0].id, 1, "rate-limit retry succeeded")
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    url,
    {
      status: 429,
      body: "{\"error\":\"throttled\"}",
      headers: {"x-ratelimit-remaining": "0", "x-ratelimit-reset": "10000"},
    },
  )
  const capped = call(
    harness,
    "api.request",
    {
      api_base_url: base,
      path: path,
      access_token: "token",
      rate_limit_max_wait_seconds: 30,
      now: 0,
    },
  )
  assert(is_err(capped), "rate-limit cap rejects")
  assert_eq(unwrap_err(capped).code, "rate_limited", "rate-limit cap returns rate_limited code")
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    url,
    {
      responses: [
        {status: 503, body: "{\"error\":\"unavailable\"}", headers: {"retry-after": "0"}},
        {status: 200, body: "{\"values\":[{\"id\":2}]}"},
      ],
    },
  )
  const retry_after = call(
    harness,
    "api.request",
    {api_base_url: base, path: path, access_token: "token", rate_limit_max_wait_seconds: 5},
  )
  assert_eq(retry_after.values[0].id, 2, "Retry-After honored on 503")
  const bucket_first = rate_limit_gate(
    nil,
    {capacity: 2, refill_tokens: 1, refill_interval_ms: 1000},
    0,
  )
  assert_eq(bucket_first.allowed, true, "token bucket first call allowed")
  const bucket_second = rate_limit_gate(
    bucket_first.state,
    {capacity: 2, refill_tokens: 1, refill_interval_ms: 1000},
    0,
  )
  assert_eq(bucket_second.allowed, true, "token bucket second call allowed")
  const bucket_third = rate_limit_gate(
    bucket_second.state,
    {capacity: 2, refill_tokens: 1, refill_interval_ms: 1000},
    0,
  )
  assert_eq(bucket_third.allowed, false, "token bucket third call exhausted")
  assert(bucket_third.retry_after_ms > 0, "token bucket exhaustion sets retry_after_ms")
  harness.testing.http_mock_clear()
}
