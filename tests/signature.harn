import { activate, init, normalize_inbound, shutdown } from "../src/lib"

fn pr_body() {
  return "{\"actor\":{\"display_name\":\"Ada\"},\"repository\":{\"full_name\":\"acme/widgets\"},\"pullrequest\":{\"id\":42}}"
}

fn pr_headers() {
  return {"x-event-key": "pullrequest:created", "x-hook-uuid": "delivery-sig"}
}

@complexity(allow)
pipeline default() {
  shutdown()
  init({signing_secret: "secret"})
  activate([{id: "primary", path: "/hooks/bitbucket", secrets: {signing_secret: "secret"}}])
  const body = pr_body()
  const prefixed = "sha256=" + hmac_sha256("secret", body)
  const prefixed_result = normalize_inbound(
    {body_text: body, headers: pr_headers() + {"x-hub-signature": prefixed}},
  )
  assert_eq(prefixed_result.type, "event", "prefixed signature accepted")
  assert_eq(prefixed_result.event.signature_status.state, "verified", "prefixed signature verified")
  const bare = hmac_sha256("secret", body)
  const bare_result = normalize_inbound(
    {body_text: body, headers: pr_headers() + {"x-hub-signature": bare}},
  )
  assert_eq(bare_result.type, "event", "bare-hex signature accepted")
  assert_eq(bare_result.event.signature_status.state, "verified", "bare-hex signature verified")
  const mismatched = normalize_inbound(
    {body_text: body, headers: pr_headers() + {"x-hub-signature": "sha256=00"}},
  )
  assert_eq(mismatched.type, "reject", "mismatched signature rejects")
  assert_eq(mismatched.reject.status, 401, "mismatched signature unauthorized")
  const missing = normalize_inbound({body_text: body, headers: pr_headers()})
  assert_eq(missing.type, "reject", "missing signature rejects when secret configured")
  assert_eq(missing.reject.status, 401, "missing signature unauthorized")
  shutdown()
  init()
  // F1 fail-closed: with no secret AND no allow_unsigned binding, unsigned rejects.
  const unsigned_reject = normalize_inbound({body_text: body, headers: pr_headers()})
  assert_eq(unsigned_reject.type, "reject", "unsigned rejects when no secret configured")
  assert_eq(unsigned_reject.reject.status, 401, "unsigned reject status 401")
  // F1 opt-in: a binding with allow_unsigned: true keeps the unsigned path.
  activate([{binding_id: "lenient", path: "/hooks/lenient", allow_unsigned: true}])
  const unsigned = normalize_inbound(
    {body_text: body, headers: pr_headers(), metadata: {binding_id: "lenient"}},
  )
  assert_eq(unsigned.type, "event", "unsigned accepted when binding opts in")
  assert_eq(unsigned.event.signature_status.state, "unsigned", "unsigned status set")
  shutdown()
}
